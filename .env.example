# One OpenAI-compatible endpoint is the ghost's home. Swap it, keep everything else.
#   laptop (Ollama):        http://127.0.0.1:11434/v1     model gemma4:e4b
#   DigitalOcean (vLLM):    http://<droplet-ip>:8000/v1   model google/gemma-4-26b-a4b-it
#   the relic (llama.cpp):  http://<uno-q-ip>:8080/v1     model gemma-4-e2b
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_ID=gemma4:e4b
MODEL_API_KEY=local

# Shared secret between the API and the DigitalOcean services (vLLM, oracle)
DO_SERVICE_TOKEN=

ORACLE_URL=http://127.0.0.1:8787
PORT=3030

# Mastra Platform traces: every ghost turn and challenge shows up under Observability → Traces.
# Create an access token for your organization and copy the project ID at https://projects.mastra.ai
# (or run `npx mastra init` in apps/api). Leave empty and tracing is a no-op.
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=
